---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Service-tinted tool card with stretched link, terse surface copy, and "i" detail tooltip.
import ToolGlyph, { type GlyphKind } from './ToolGlyph.astro';
import InfoTip from './InfoTip.astro';
import type { ToolEntry } from '../lib/tools';

interface Props {
  tool: ToolEntry;
  fallbackIcon: GlyphKind;
}

const { tool, fallbackIcon } = Astro.props;
---

<li
  data-tool-item
  data-category={tool.category}
  data-search={`${tool.name} ${tool.category} ${tool.group} ${tool.short} ${tool.blurb}`.toLowerCase()}
>
  <article class="tool-card" data-tool={tool.id} data-accent={tool.accent}>
    <div class="tool-card__top">
      <ToolGlyph kind={tool.id} fallback={fallbackIcon} tone={tool.accent} size="lg" />
      <div class="tool-card__meta">
        <span class="tool-card__group">{tool.group}</span>
        <InfoTip label={`About ${tool.name}`} text={tool.blurb} align="end" />
      </div>
    </div>

    <div class="tool-card__body">
      <h3 class="tool-card__title">
        <a class="tool-card__link" href={`/tools/${tool.id}`}>{tool.name}</a>
      </h3>
      <p class="tool-card__blurb">{tool.short}</p>
    </div>

    <span class="tool-card__action" aria-hidden="true">
      Open
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14" /><path d="m13 6 6 6-6 6" />
      </svg>
    </span>
  </article>
</li>
