---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Crisp white tool card with distinct service-colored icon, concise copy, and clean footer.
import ToolGlyph, { type GlyphKind } from './ToolGlyph.astro';
import type { ToolEntry } from '../lib/tools';

interface Props {
  tool: ToolEntry;
  fallbackIcon: GlyphKind;
}

const { tool, fallbackIcon } = Astro.props;
---

<li
  data-tool-item
  data-category={tool.category}
  data-search={`${tool.name} ${tool.category} ${tool.group} ${tool.short} ${tool.blurb}`.toLowerCase()}
>
  <a class="tool-card" href={`/tools/${tool.id}`} data-tool={tool.id} data-accent={tool.accent}>
    <ToolGlyph kind={tool.id} fallback={fallbackIcon} tone={tool.accent} size="lg" />

    <span class="tool-card__body">
      <span class="tool-card__title">{tool.name}</span>
      <span class="tool-card__blurb">{tool.short}</span>
    </span>

    <span class="tool-card__foot" aria-hidden="true">
      <span class="tool-card__group">{tool.group}</span>
      <span class="tool-card__arrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14" /><path d="m13 6 6 6-6 6" />
        </svg>
      </span>
    </span>
  </a>
</li>
