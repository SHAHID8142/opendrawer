---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Breadcrumb navigation for tool slug and policy pages.
interface Props {
  current: string;
  group?: string;
}

const { current, group } = Astro.props;
---

<nav aria-label="Breadcrumb">
  <ol class="breadcrumb">
    <li><a href="/">Home</a></li>
    {group && (
      <>
        <li class="breadcrumb__sep" aria-hidden="true">/</li>
        <li><span>{group}</span></li>
      </>
    )}
    <li class="breadcrumb__sep" aria-hidden="true">/</li>
    <li aria-current="page">{current}</li>
  </ol>
</nav>
