---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Ordered dot-matrix wave backdrop for the hero with gentle cursor lensing and reduced-motion pause.
---

<canvas class="ambient-canvas" id="ambient-canvas" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById('ambient-canvas') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const styles = getComputedStyle(document.documentElement);
    const baseColor = styles.getPropertyValue('--color-text-muted').trim() || styles.getPropertyValue('--color-border').trim();
    const waveColor = styles.getPropertyValue('--color-inspect').trim() || styles.getPropertyValue('--color-accent').trim();

    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    let width = 0, height = 0, rafId = 0, time = 0, inView = true;
    const pointer = { x: -9999, y: -9999, active: false };
    const halo = { cx: 0, cy: 0, rx: 280, ry: 110 };

    interface Dot {
      bx: number; by: number;
      dx: number; dy: number;
      vx: number; vy: number;
    }
    let dots: Dot[] = [];

    const smoothstep = (a: number, b: number, x: number) => {
      const t = Math.max(0, Math.min(1, (x - a) / Math.max(0.0001, b - a)));
      return t * t * (3 - 2 * t);
    };

    function measureHalo(rect: DOMRect) {
      const head = canvas?.parentElement?.querySelector('.page-head');
      if (!head) {
        halo.cx = width * 0.5; halo.cy = height * 0.5;
        halo.rx = Math.min(width * 0.36, 300); halo.ry = height * 0.4;
        return;
      }
      const r = head.getBoundingClientRect();
      halo.cx = r.left - rect.left + r.width * 0.5;
      halo.cy = r.top - rect.top + r.height * 0.5;
      halo.rx = r.width * 0.5 + 16;
      halo.ry = r.height * 0.52 + 10;
    }

    function buildGrid() {
      dots = [];
      const step = width < 640 ? 22 : 26;
      const cols = Math.ceil(width / step) + 1;
      const rows = Math.ceil(height / step) + 1;
      const offsetX = (width - (cols - 1) * step) * 0.5;
      const offsetY = (height - (rows - 1) * step) * 0.5;

      for (let row = 0; row < rows; row += 1) {
        for (let col = 0; col < cols; col += 1) {
          dots.push({
            bx: offsetX + col * step,
            by: offsetY + row * step,
            dx: 0, dy: 0, vx: 0, vy: 0,
          });
        }
      }
    }

    function resize() {
      const rect = canvas!.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = rect.width; height = rect.height;
      canvas!.width = Math.max(1, Math.floor(width * dpr));
      canvas!.height = Math.max(1, Math.floor(height * dpr));
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      measureHalo(rect);
      buildGrid();
    }

    function drawFrame() {
      ctx!.clearRect(0, 0, width, height);
      const rect = canvas!.getBoundingClientRect();
      measureHalo(rect);
      const px = pointer.x - rect.left;
      const py = pointer.y - rect.top;
      const pRad = width < 640 ? 110 : 175;
      const reduced = motionQuery.matches;
      if (!reduced) time += 0.022;

      for (const d of dots) {
        let aura = 0;
        if (!reduced) {
          if (pointer.active) {
            const dx = d.bx + d.dx - px;
            const dy = d.by + d.dy - py;
            const dist2 = dx * dx + dy * dy;
            if (dist2 > 1 && dist2 < pRad * pRad) {
              const dist = Math.sqrt(dist2);
              const s = 1 - dist / pRad;
              aura = s * s;
              const push = aura * 1.45;
              d.vx += (dx / dist) * push;
              d.vy += (dy / dist) * push;
            }
          }
          d.vx = (d.vx - d.dx * 0.08) * 0.8;
          d.vy = (d.vy - d.dy * 0.08) * 0.8;
          d.dx += d.vx;
          d.dy += d.vy;
        }

        const waveA = reduced ? 0.4 : 0.5 + 0.5 * Math.sin(d.bx * 0.009 - d.by * 0.012 - time * 1.4);
        const waveB = reduced ? 0.5 : 0.5 + 0.5 * Math.cos(d.bx * 0.005 + d.by * 0.008 + time * 0.9);
        const crest = waveA * 0.65 + waveB * 0.35;

        const x = d.bx + d.dx;
        const y = d.by + d.dy - (reduced ? 0 : crest * 3.5);

        const normDist = Math.hypot((x - halo.cx) / halo.rx, (y - halo.cy) / halo.ry);
        const textFade = 0.22 + 0.78 * smoothstep(0.6, 1.2, normDist);

        const radius = 0.95 + crest * 0.85 + aura * 1.4;
        const alpha = (0.09 + crest * 0.17 + aura * 0.38) * textFade;
        if (alpha < 0.02) continue;

        ctx!.globalAlpha = Math.min(0.65, alpha);
        ctx!.fillStyle = aura > 0.14 || crest > 0.72 ? waveColor : baseColor;
        ctx!.beginPath();
        ctx!.arc(x, y, radius, 0, Math.PI * 2);
        ctx!.fill();
      }
      ctx!.globalAlpha = 1;
    }

    function tick() {
      drawFrame();
      rafId = !motionQuery.matches && !document.hidden && inView ? requestAnimationFrame(tick) : 0;
    }
    function start() {
      cancelAnimationFrame(rafId);
      if (motionQuery.matches) { drawFrame(); return; }
      if (!document.hidden && inView) rafId = requestAnimationFrame(tick);
    }

    new IntersectionObserver((e) => {
      inView = e[0]?.isIntersecting ?? true;
      if (inView) start(); else { cancelAnimationFrame(rafId); rafId = 0; }
    }).observe(canvas);
    window.addEventListener('resize', () => { resize(); if (motionQuery.matches) drawFrame(); });
    window.addEventListener('pointermove', (e) => {
      pointer.x = e.clientX; pointer.y = e.clientY; pointer.active = true;
    }, { passive: true });
    window.addEventListener('pointerleave', () => { pointer.active = false; });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { cancelAnimationFrame(rafId); rafId = 0; } else start();
    });
    motionQuery.addEventListener('change', start);
    resize(); start();
  }
</script>
