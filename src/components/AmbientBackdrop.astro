---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Structured orbital micro-dot constellation inside the hero backdrop with spring pointer physics.
---

<canvas class="ambient-canvas" id="ambient-canvas" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById('ambient-canvas') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const styles = getComputedStyle(document.documentElement);
    const palette = [
      styles.getPropertyValue('--color-inspect').trim(),
      styles.getPropertyValue('--color-convert').trim(),
      styles.getPropertyValue('--color-everyday').trim(),
      styles.getPropertyValue('--color-documents').trim(),
      styles.getPropertyValue('--color-audio').trim(),
      styles.getPropertyValue('--color-textdata').trim(),
    ].filter(Boolean);

    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    let width = 0;
    let height = 0;
    let rafId = 0;
    let time = 0;
    let inView = true;
    const pointer = { x: -9999, y: -9999, active: false };

    interface Node {
      homeX: number;
      homeY: number;
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
      phase: number;
      alpha: number;
      color: string;
    }

    let nodes: Node[] = [];

    function buildOrbitalField() {
      nodes = [];
      const cx = width * 0.5;
      const cy = height * 0.46;
      const rings = width < 640 ? [150, 210] : [230, 320, 420];
      const counts = width < 640 ? [18, 24] : [28, 38, 46];

      rings.forEach((rxBase, ringIdx) => {
        const count = counts[ringIdx];
        const ryBase = rxBase * 0.52;
        for (let i = 0; i < count; i += 1) {
          const theta = (i / count) * Math.PI * 2 + ringIdx * 0.35;
          const jitter = ((i % 3) - 1) * 10;
          const homeX = cx + Math.cos(theta) * (rxBase * (width < 640 ? 1 : 1.25) + jitter);
          const homeY = cy + Math.sin(theta) * (ryBase + jitter * 0.5);
          nodes.push({
            homeX,
            homeY,
            x: homeX,
            y: homeY,
            vx: 0,
            vy: 0,
            radius: ringIdx === 0 ? 1.8 : 2.2,
            phase: theta * 2 + ringIdx,
            alpha: 0.28 + (ringIdx === 1 ? 0.14 : 0),
            color: palette[(i + ringIdx * 2) % palette.length] || styles.getPropertyValue('--color-accent').trim(),
          });
        }
      });
    }

    function resize() {
      const rect = canvas!.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas!.width = Math.max(1, Math.floor(width * dpr));
      canvas!.height = Math.max(1, Math.floor(height * dpr));
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      buildOrbitalField();
    }

    function drawFrame() {
      ctx!.clearRect(0, 0, width, height);
      const rect = canvas!.getBoundingClientRect();
      const localPx = pointer.x - rect.left;
      const localPy = pointer.y - rect.top;
      const radius = 140;

      if (!motionQuery.matches) time += 0.014;

      for (const n of nodes) {
        const targetX = n.homeX + (motionQuery.matches ? 0 : Math.cos(time + n.phase) * 7);
        const targetY = n.homeY + (motionQuery.matches ? 0 : Math.sin(time * 0.9 + n.phase) * 5);

        if (!motionQuery.matches) {
          if (pointer.active) {
            const dx = n.x - localPx;
            const dy = n.y - localPy;
            const d2 = dx * dx + dy * dy;
            if (d2 > 1 && d2 < radius * radius) {
              const d = Math.sqrt(d2);
              const push = (1 - d / radius) * 3.2;
              n.vx += (dx / d) * push;
              n.vy += (dy / d) * push;
            }
          }
          n.vx += (targetX - n.x) * 0.045;
          n.vy += (targetY - n.y) * 0.045;
          n.vx *= 0.84;
          n.vy *= 0.84;
          n.x += n.vx;
          n.y += n.vy;
        }

        ctx!.globalAlpha = n.alpha;
        ctx!.fillStyle = n.color;
        ctx!.beginPath();
        ctx!.arc(n.x, n.y, n.radius, 0, Math.PI * 2);
        ctx!.fill();
      }
      ctx!.globalAlpha = 1;
    }

    function tick() {
      drawFrame();
      if (!motionQuery.matches && !document.hidden && inView) {
        rafId = requestAnimationFrame(tick);
      } else {
        rafId = 0;
      }
    }

    function start() {
      cancelAnimationFrame(rafId);
      if (motionQuery.matches) {
        drawFrame();
        return;
      }
      if (!document.hidden && inView) {
        rafId = requestAnimationFrame(tick);
      }
    }

    const observer = new IntersectionObserver((entries) => {
      inView = entries[0]?.isIntersecting ?? true;
      if (inView) start();
      else {
        cancelAnimationFrame(rafId);
        rafId = 0;
      }
    });
    observer.observe(canvas);

    window.addEventListener('resize', () => {
      resize();
      if (motionQuery.matches) drawFrame();
    });
    window.addEventListener('pointermove', (e) => {
      pointer.x = e.clientX;
      pointer.y = e.clientY;
      pointer.active = true;
    }, { passive: true });
    window.addEventListener('pointerleave', () => {
      pointer.active = false;
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(rafId);
        rafId = 0;
      } else {
        start();
      }
    });
    motionQuery.addEventListener('change', start);

    resize();
    start();
  }
</script>
