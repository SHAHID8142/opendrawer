---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Bare freestanding Google Material Symbols Rounded icons with category fallback.
import { GLYPH_PATHS, type GlyphKind } from '../lib/glyph-paths';
import type { ToolAccent } from '../lib/tools';

export type { GlyphKind };
export type GlyphTone = ToolAccent;

interface Props {
  kind: string;
  fallback?: GlyphKind;
  tone?: GlyphTone;
  size?: 'sm' | 'md' | 'lg';
  contained?: boolean;
}

const { kind, fallback = 'documents', tone = 'inspect', size = 'md', contained = false } = Astro.props;
const pathData = GLYPH_PATHS[kind as GlyphKind] ?? GLYPH_PATHS[fallback];
---

<span class={`glyph glyph--${size} glyph--${tone}${contained ? ' glyph--contained' : ''}`} aria-hidden="true">
  <svg viewBox="0 -960 960 960" fill="currentColor">
    <path d={pathData} />
  </svg>
</span>
