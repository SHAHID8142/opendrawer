---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/patterns.css';
import '../styles/tool-page.css';
import '../styles/ui/button.css';
import '../styles/ui/field.css';
import '../styles/ui/card.css';
import '../styles/ui/feedback.css';
import '../styles/ui/dropzone.css';
import '../styles/ui/dialog.css';
import '../styles/ui/table.css';
import '../styles/ui/progress.css';
import '../styles/ui/list.css';
import '../styles/ui/tool-list.css';
import { THEME_COLOR } from '../lib/theme-colors';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const siteName = 'OpenDrawer';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content={THEME_COLOR} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href="/">
          <span class="brand__mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 8h16" />
              <path d="M6 8v9a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V8" />
              <path d="M9 5h6" />
            </svg>
          </span>
          OpenDrawer
        </a>
        <nav class="site-nav" aria-label="Main">
          <a href="/#tools">Tools</a>
          <a href="/privacy">Privacy</a>
          <a class="site-nav__source" href="https://github.com/SHAHID8142/opendrawer" rel="noopener">Source</a>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap stack-sm">
        <p>
          OpenDrawer is free and open source under the AGPL-3.0. Files are processed in your
          browser: no account, no advertising, no upload.
        </p>
        <p class="cluster">
          <a href="/privacy">How to verify nothing is uploaded</a>
          <a href="https://github.com/SHAHID8142/opendrawer" rel="noopener">Source code</a>
        </p>
      </div>
    </footer>
  </body>
</html>
