---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/patterns.css';
import '../styles/tool-page.css';
import '../styles/ui/button.css';
import '../styles/ui/field.css';
import '../styles/ui/card.css';
import '../styles/ui/feedback.css';
import '../styles/ui/dropzone.css';
import '../styles/ui/dialog.css';
import '../styles/ui/table.css';
import '../styles/ui/progress.css';
import '../styles/ui/list.css';
import '../styles/ui/tool-list.css';
import '../styles/ui/catalog.css';
import '../styles/ui/glyph.css';
import '../styles/ui/infotip.css';
import '../styles/ui/backdrop.css';
import { THEME_COLOR } from '../lib/theme-colors';
import QuickSwitcher from '../components/QuickSwitcher.astro';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const siteName = 'OpenDrawer';
const pathname = Astro.url.pathname;
const isToolsArea = pathname === '/' || pathname.startsWith('/tools/');
const isPrivacy = pathname === '/privacy' || pathname.startsWith('/privacy/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content={THEME_COLOR} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <meta property="og:image" content={new URL('/brand/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/brand/og.png', Astro.site).href} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href="/">
          <img class="brand__mark" src="/brand/mark-color.svg" alt="" width="34" height="34" />
          OpenDrawer
        </a>
        <nav class="site-nav" aria-label="Main">
          <a href="/#tools" aria-current={isToolsArea ? 'page' : undefined}>Tools</a>
          <a href="/privacy" aria-current={isPrivacy ? 'page' : undefined}>Privacy</a>
          <a class="site-nav__source" href="https://github.com/SHAHID8142/opendrawer" rel="noopener">
            Source
          </a>
        </nav>
        <div class="site-header__actions">
          <button type="button" class="nav-search" id="nav-quick-open" title="Jump to any tool (⌘K)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
            </svg>
            <span class="nav-search__label">Find tool</span>
            <kbd class="nav-search__kbd" aria-hidden="true">⌘K</kbd>
          </button>
        </div>
      </div>
    </header>
    <QuickSwitcher />
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <p>
          OpenDrawer is free open-source software under the AGPL-3.0. Files stay in your browser:
          no account, no ads, no upload.
        </p>
        <p class="site-footer__links">
          <span>Maintained by <strong>SHAHIDUL ISLAM</strong></span>
          <a href="https://www.aperiostudios.com/" rel="noopener">Aperio Studio</a>
          <a href="https://wa.me/8801840488142" rel="noopener">WhatsApp: 01840488142</a>
          <a href="/privacy">How to verify nothing is uploaded</a>
          <a href="https://github.com/SHAHID8142/opendrawer" rel="noopener">Source code</a>
        </p>
      </div>
    </footer>
    <script>
      const infoTips = Array.from(document.querySelectorAll<HTMLElement>('[data-info-tip]'));
      for (const tip of infoTips) {
        const trigger = tip.querySelector<HTMLButtonElement>('.info-tip__trigger');
        trigger?.addEventListener('click', (event) => {
          event.stopPropagation();
          const next = tip.dataset.open !== 'true';
          for (const other of infoTips) {
            other.dataset.open = 'false';
            other.querySelector('.info-tip__trigger')?.setAttribute('aria-expanded', 'false');
          }
          tip.dataset.open = next ? 'true' : 'false';
          trigger.setAttribute('aria-expanded', next ? 'true' : 'false');
        });
      }
      document.addEventListener('click', () => {
        for (const tip of infoTips) {
          tip.dataset.open = 'false';
          tip.querySelector('.info-tip__trigger')?.setAttribute('aria-expanded', 'false');
        }
      });
    </script>
  </body>
</html>
