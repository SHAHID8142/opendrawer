---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolGlyph from '../components/ToolGlyph.astro';

const title = 'Privacy: files never leave your device';
const description =
  'How OpenDrawer keeps files on your device: no upload endpoint, no account, no analytics, and a Content-Security-Policy that only allows this origin. Verify it yourself in three steps.';
---

<Base title={`${title} — OpenDrawer`} description={description}>
  <div class="stack-lg">
    <Breadcrumb current="Privacy" />

    <header class="tool-head">
      <h1>Privacy you can verify</h1>
      <p>
        There is no upload endpoint in this site and no server behind it. The browser is the
        computer doing the work, so there is nothing to trust with your file.
      </p>
    </header>

    <ol class="steps">
      <li>
        <div class="step__head">
          <ToolGlyph kind="network" tone="inspect" size="md" />
          <span class="step__num step__num--inspect">01 · Network</span>
        </div>
        <h3>Open the Network tab</h3>
        <p>
          Press <kbd>F12</kbd>, or <kbd>Cmd+Option+I</kbd> on a Mac, then choose Network and clear
          the list.
        </p>
      </li>
      <li>
        <div class="step__head">
          <ToolGlyph kind="tool" tone="convert" size="md" />
          <span class="step__num step__num--convert">02 · Run tool</span>
        </div>
        <h3>Use a tool</h3>
        <p>Pick a file and let the tool run. No request leaves this page while it works.</p>
      </li>
      <li>
        <div class="step__head">
          <ToolGlyph kind="wifi-off" tone="audio" size="md" />
          <span class="step__num step__num--audio">03 · Wi-Fi off</span>
        </div>
        <h3>Switch off Wi-Fi</h3>
        <p>The tool still works after the page loads, because none of it needs a server.</p>
      </li>
    </ol>

    <section class="stack" aria-labelledby="compare-heading">
      <h2 id="compare-heading">Cloud PDF sites vs OpenDrawer</h2>
      <div
        class="table-scroll"
        tabindex="0"
        role="region"
        aria-label="Comparison of cloud PDF sites and OpenDrawer"
      >
        <table class="table-compare">
          <thead>
            <tr>
              <th scope="col">Check</th>
              <th scope="col">Typical cloud PDF site</th>
              <th scope="col">OpenDrawer</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Where files go</th>
              <td>
                <span class="table-compare__label" aria-hidden="true">Typical cloud PDF site</span>
                Uploaded to a remote server
              </td>
              <td class="table-compare__good">
                <span class="table-compare__label" aria-hidden="true">OpenDrawer</span>
                Stay in browser memory on your device
              </td>
            </tr>
            <tr>
              <th scope="row">Retention</th>
              <td>
                <span class="table-compare__label" aria-hidden="true">Typical cloud PDF site</span>
                Deleted after 1 to 2 hours, by policy
              </td>
              <td class="table-compare__good">
                <span class="table-compare__label" aria-hidden="true">OpenDrawer</span>
                Never stored; cleared when the tab closes
              </td>
            </tr>
            <tr>
              <th scope="row">Accounts and quotas</th>
              <td>
                <span class="table-compare__label" aria-hidden="true">Typical cloud PDF site</span>
                Task caps, watermarks or sign-in walls
              </td>
              <td class="table-compare__good">
                <span class="table-compare__label" aria-hidden="true">OpenDrawer</span>
                No accounts, no quotas, no watermarks
              </td>
            </tr>
            <tr>
              <th scope="row">Offline after load</th>
              <td>
                <span class="table-compare__label" aria-hidden="true">Typical cloud PDF site</span>
                Fails without an internet connection
              </td>
              <td class="table-compare__good">
                <span class="table-compare__label" aria-hidden="true">OpenDrawer</span>
                Works with Wi-Fi switched off
              </td>
            </tr>
            <tr>
              <th scope="row">Proof</th>
              <td>
                <span class="table-compare__label" aria-hidden="true">Typical cloud PDF site</span>
                Legal privacy statement
              </td>
              <td class="table-compare__good">
                <span class="table-compare__label" aria-hidden="true">OpenDrawer</span>
                Open source plus browser CSP and Network tab
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="stack" aria-labelledby="never-heading">
      <h2 id="never-heading">What this product will never do</h2>
      <ul class="never-list">
        <li>Upload, copy or store a file you open.</li>
        <li>Ask for an account, an email address or a cookie.</li>
        <li>Run analytics, error reporting, ads or A/B tests.</li>
        <li>Add a watermark, a quota, a file limit or an upgrade prompt.</li>
        <li>Load a script, font or icon from another domain.</li>
        <li>Transmit filenames or file contents to localStorage.</li>
      </ul>
    </section>

    <aside class="note note--inspect" aria-labelledby="enforced-heading">
      <h2 id="enforced-heading" class="note__title">
        <svg
          class="note__icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3 5 6v5.5c0 4.6 3 8.4 7 9.5 4-1.1 7-4.9 7-9.5V6l-7-3Z" />
          <path d="m9 12 2.2 2.2L15.5 10" />
        </svg>
        <span>Enforced, not promised</span>
      </h2>
      <p>
        The Content-Security-Policy in <code>public/_headers</code> sets{' '}
        <code>default-src 'self'</code>, <code>connect-src 'self'</code>,{' '}
        <code>form-action 'none'</code> and <code>frame-ancestors 'none'</code>. Even a future bug
        cannot send a file to another domain because the browser blocks off-origin requests. The
        automated test suite also fails if any request leaves the origin during a tool run.
      </p>
    </aside>
  </div>
</Base>
