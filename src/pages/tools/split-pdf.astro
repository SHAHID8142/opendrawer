---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LimitsNote from '../../components/LimitsNote.astro';
import Tool from '../../tools/split-pdf/Tool';

const title = 'Split PDF: one file per range or per page';
const description =
  'Split a PDF into separate documents by page ranges, or one file per page. Pages are copied, not re-rendered, and nothing is uploaded. Free and open source.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'OpenDrawer — Split PDF',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any browser',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};

const faq = [
  {
    question: 'Is the PDF uploaded to split it?',
    answer:
      'No. The file is read in this tab and the selected pages are copied into new documents locally.',
  },
  {
    question: 'When do I get a ZIP?',
    answer:
      'When the split produces more than one file. A single range gives a single PDF download; several ranges or one-file-per-page give a ZIP.',
  },
  {
    question: 'Does splitting keep the text selectable?',
    answer:
      'Yes. Pages are copied, not rendered, so text, links and image quality are unchanged. Document-level metadata and bookmarks are not copied into the new files.',
  },
];
---

<Base title={`${title} — OpenDrawer`} description={description} jsonLd={jsonLd}>
  <div class="stack-lg">
    <Breadcrumb current="Split PDF" />

    <header class="tool-head">
      <h1 id="tool-heading">Split PDF</h1>
      <p>
        Take a PDF apart: give a list of ranges and get one document per range, or split every
        page into its own file. The work happens in the browser.
      </p>
    </header>

    <div class="tool-layout">
      <div class="tool-main stack-lg">
        <Tool client:load />
      </div>

      <aside class="tool-aside stack">
        <LimitsNote
          title="What this tool cannot do"
          items={[
            'Up to 500 pages copied in one split.',
            'Password-protected PDFs are refused. Remove the password first.',
            'Each comma-separated range becomes a separate PDF: "1-3, 7" makes two files.',
            'Pages are copied, not compressed, so the total output can be close to the input size.',
            'Bookmarks, form fields and document metadata are not carried into the new files.',
            'Digital signatures stop being valid once the file is split.',
          ]}
        />
        <section class="stack" aria-labelledby="faq-heading">
          <h2 id="faq-heading">Questions</h2>
          <div class="faq">
            {faq.map((item) => (
              <div class="note">
                <h3>{item.question}</h3>
                <p>{item.answer}</p>
              </div>
            ))}
          </div>
        </section>
      </aside>
    </div>
  </div>
</Base>
