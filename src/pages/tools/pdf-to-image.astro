---
import Base from '../../layouts/Base.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ToolFaq from '../../components/ToolFaq.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import LimitsNote from '../../components/LimitsNote.astro';
import Tool from '../../tools/pdf-to-image/Tool';

const title = 'PDF to image: pages as PNG, JPEG, WebP or AVIF';
const description =
  'Turn PDF pages into PNG, JPEG, WebP or AVIF images at the resolution you choose. Pick a page range, then download one image or a ZIP. Runs in your browser; nothing is uploaded.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'OpenDrawer — PDF to image',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any browser',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};

const faq = [
  {
    question: 'Is my PDF uploaded to render the pages?',
    answer:
      'No. The rendering happens in this tab, and the worker that decodes the file is served from this site. You can watch the Network tab while it runs.',
  },
  {
    question: 'Why is the text blurry at 72 DPI?',
    answer:
      '72 DPI is one pixel per point, which is screen size and roughly what the page looks like at 100 percent zoom. Text is drawn as pixels, so for reading or printing choose 150 or 300 DPI.',
  },
  {
    question: 'Which image format should I choose?',
    answer:
      'PNG keeps every pixel and is best for text and screenshots. JPEG is smaller and fine for photographs. WebP is smaller again with little visible loss and is widely supported. AVIF is the smallest, and the option only appears as available when this browser can actually encode it.',
  },
  {
    question: 'Why is AVIF greyed out?',
    answer:
      'Browsers encode images through their canvas API, and not every browser can write AVIF. The format list is checked in this tab when the page loads, so an unsupported format is labelled rather than silently producing a PNG with an .avif name.',
  },
  {
    question: 'Can I get the text back out of the images?',
    answer:
      'Not from these files. A rendered page is a picture: the text is no longer selectable or searchable, and OCR would be needed to recover it. Use a text extraction tool when you need the words.',
  },
];
---

<Base title={`${title} — OpenDrawer`} description={description} jsonLd={jsonLd}>
  <div class="stack-lg">
    <ToolHeader
      id="pdf-to-image"
      breadcrumbLabel="PDF to image"
      heading="PDF to image"
      lead="Turn the pages of a PDF into pictures: PNG for no quality loss, JPEG or WebP for smaller files, and AVIF where your browser can write it. Pick the resolution and the pages; the images are drawn here in your browser."
    />

    <div class="tool-layout">
      <div class="tool-main stack-lg">
        <Tool client:load />
      </div>

      <aside class="tool-aside stack">
        <LimitsNote
          title="What this tool cannot do"
          items={[
            'A rendered page is a picture. The text stops being selectable, searchable and copyable.',
            'One page above 40 megapixels is refused, which is roughly 600 DPI on A4. Memory grows with resolution and page count, and a phone is not a print shop.',
            'More than 200 pages in one run is refused. Split the document first.',
            'Page ranges are 1-based and can be combined: 1-3, 7, 10-12.',
            'Links, forms, annotations and hidden layers are not drawn as interactive elements; they appear only as whatever the page shows.',
            'AVIF depends on the browser. Where it cannot be encoded, the option is disabled instead of quietly falling back to another format.',
          ]}
        />
        <ToolFaq items={faq} />
      </aside>
    </div>
    <RelatedTools currentId="pdf-to-image" />
  </div>
</Base>
