---
import Base from '../../layouts/Base.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ToolFaq from '../../components/ToolFaq.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import LimitsNote from '../../components/LimitsNote.astro';
import Tool from '../../tools/rotate-pdf/Tool';

const title = 'Rotate PDF: turn pages upright without losing quality';
const description =
  'Rotate all pages or only the ones you choose by 90, 180 or 270 degrees. Rotation is a page setting, so text stays selectable and nothing is uploaded.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'OpenDrawer — Rotate PDF',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any browser',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};

const faq = [
  {
    question: 'Does rotating reduce quality?',
    answer:
      'No. Rotation is stored as a page setting; the page content is not re-rendered or re-compressed.',
  },
  {
    question: 'Can I rotate only some pages?',
    answer:
      'Yes. Leave the page box empty to turn every page, or enter pages and ranges such as 1-3, 7.',
  },
  {
    question: 'Why did a page rotate further than expected?',
    answer:
      'Rotation is added to whatever the file already had. A scan stored as 270° plus 90° becomes upright; rotating it again with 90° would take it to 90°.',
  },
];
---

<Base title={`${title} — OpenDrawer`} description={description} jsonLd={jsonLd}>
  <div class="stack-lg">
    <ToolHeader
      id="rotate-pdf"
      breadcrumbLabel="Rotate PDF"
      heading="Rotate PDF"
      lead="Turn sideways scans and upside-down pages the right way up. Choose an angle and the pages it applies to; the change is written where the file already keeps rotation."
    />

    <div class="tool-layout">
      <div class="tool-main stack-lg">
        <Tool client:load />
      </div>

      <aside class="tool-aside stack">
        <LimitsNote
          title="What this tool cannot do"
          items={[
            'It does not rotate the content itself. Rotation is a page setting some viewers and printers ignore.',
            'Password-protected PDFs are refused. Remove the password first.',
            'Pages are not cropped or straightened; a skewed scan stays skewed.',
            'A rotation that makes the page landscape stays landscape in the reader, not physically re-laid out.',
            'Digital signatures stop being valid once the file changes.',
          ]}
        />
        <ToolFaq items={faq} />
      </aside>
    </div>
    <RelatedTools currentId="rotate-pdf" />
  </div>
</Base>
