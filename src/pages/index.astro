---
import Base from '../layouts/Base.astro';
import { liveTools, tools, type ToolCategory } from '../lib/tools';

const categories: ToolCategory[] = ['Documents', 'Images', 'Audio & video', 'Text & data', 'Everyday'];

function countIn(name: ToolCategory) {
  return tools.filter((tool) => tool.category === name).length;
}
---

<Base
  title="OpenDrawer — everyday file tools that never upload"
  description="Free, open-source tools that run in your browser: inspect a PDF, turn its pages into images, and more added one at a time. No account, no ads, no upload."
>
  <div class="stack-lg page-fill">
    <header class="page-head">
      <h1>Everyday file tools</h1>
      <p>Free, local, no upload. One finished tool at a time.</p>
    </header>

    <div class="catalog">
      <aside class="catalog__rail" aria-labelledby="categories-heading">
        <h2 id="categories-heading">Index</h2>
        <ul class="cat-list" role="list">
          {
            categories
              .filter((category) => countIn(category) > 0)
              .map((category) => (
                <li class="cat cat--active">
                  <span>{category}</span>
                  <span class="cat__leader" aria-hidden="true"></span>
                  <span class="cat__count">{countIn(category)}</span>
                </li>
              ))
          }
        </ul>
        <p class="rail-note">
          Files are read in your browser. <a href="/privacy">Verify it in the Network tab</a>.
        </p>
        <p class="cat__soon">In progress: Images, audio, text, everyday.</p>
      </aside>

      <section class="catalog__main" id="tools" aria-labelledby="tools-heading">
        <div class="catalog__head">
          <h2 id="tools-heading">Documents</h2>
          <span class="badge">{liveTools.length} tools</span>
        </div>

        <ul class="tool-list" role="list">
          {
            liveTools.map((tool, index) => (
              <li>
                <a class="tool-row" href={`/tools/${tool.id}`} data-category={tool.category}>
                  <span class="tool-row__index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="tool-row__text">
                    <span class="tool-row__title">{tool.name}</span>
                    <span class="tool-row__blurb">{tool.blurb}</span>
                  </span>
                  <span class="tool-row__action">
                    Open
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M5 12h14" />
                      <path d="m13 6 6 6-6 6" />
                    </svg>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <p class="catalog__foot">
          Every tool is finished, tested and documented before the next one begins.
        </p>
      </section>
    </div>

    <p class="colophon">
      <span>Colophon</span>
      <span>Paper and ink, set in the system serif</span>
      <span>Runs on your machine</span>
    </p>
  </div>
</Base>
