---
import Base from '../layouts/Base.astro';
import { liveTools } from '../lib/tools';
---

<Base
  title="OpenDrawer — everyday file tools that never upload"
  description="Free, open-source tools that run in your browser: inspect a PDF, turn its pages into images, and more added one at a time. No account, no ads, no upload."
>
  <div class="stack-lg">
    <section class="home-intro" aria-labelledby="home-heading">
      <h1 id="home-heading">Everyday file tools. Nothing uploaded.</h1>
      <p>
        Inspect a PDF or turn its pages into images. Free, open source, and running entirely in
        this tab.
      </p>
    </section>

    <section class="stack" id="tools" aria-labelledby="tools-heading">
      <div class="section-head cluster">
        <h2 id="tools-heading">Tools</h2>
        <span class="badge">{liveTools.length} live</span>
      </div>

      <ul class="tool-list" role="list">
        {
          liveTools.map((tool) => (
            <li>
              <a class="tool-row" href={`/tools/${tool.id}`}>
                <span class="tool-row__icon" aria-hidden="true">
                  {tool.id === 'inspect-pdf' ? (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="11" cy="11" r="6" />
                      <path d="m20 20-4.5-4.5" />
                    </svg>
                  ) : (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="5" width="18" height="14" rx="2" />
                      <circle cx="9" cy="10" r="1.5" />
                      <path d="m21 15-4.5-4.5L7 19" />
                    </svg>
                  )}
                </span>
                <span class="tool-row__text">
                  <span class="tool-row__title">{tool.name}</span>
                  <span class="tool-row__blurb">{tool.blurb}</span>
                </span>
                <span class="tool-row__action">
                  Open
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M5 12h14" />
                    <path d="m13 6 6 6-6 6" />
                  </svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <p class="home-next muted">
      Images, audio, text and everyday tools come next, one finished tool at a time.
    </p>
  </div>
</Base>
