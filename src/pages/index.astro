---
import Base from '../layouts/Base.astro';
import ToolGlyph, { type GlyphKind } from '../components/ToolGlyph.astro';
import { liveTools, type ToolEntry } from '../lib/tools';

type FilterGroup = 'All' | ToolEntry['group'];

const groupTabs: Array<{ id: FilterGroup; label: string; tone: string }> = [
  { id: 'All', label: 'All PDF tools', tone: 'all' },
  { id: 'Inspect', label: 'Inspect', tone: 'inspect' },
  { id: 'Convert', label: 'Convert', tone: 'convert' },
  { id: 'Create', label: 'Create', tone: 'create' },
  { id: 'Organise', label: 'Organise', tone: 'organise' },
];

function groupCount(group: FilterGroup): number {
  return group === 'All'
    ? liveTools.length
    : liveTools.filter((tool) => tool.group === group).length;
}
---

<Base
  title="OpenDrawer — everyday file tools, kept on your device"
  description="Free, open-source file tools built for public goodwill. Inspect, convert, create, merge, split and rotate PDFs inside your browser: offline after first load, zero accounts, zero tracking, zero uploads."
>
  <div class="stack-lg page-fill">
    <header class="page-head">
      <h1>Everyday file tools, kept on your device</h1>
      <p class="page-head__lead">
        Built for public goodwill as free open-source software under the AGPL-3.0. Every tool runs
        inside your browser and keeps working offline after the first load, with zero accounts, zero
        tracking and zero uploads.
      </p>
      <ul class="trust-strip" aria-label="Core guarantees">
        <li class="trust-chip--mint">0 uploads</li>
        <li class="trust-chip--sky">No account</li>
        <li class="trust-chip--amber">Offline ready</li>
        <li class="trust-chip--coral">AGPL-3.0</li>
      </ul>
    </header>

    <div class="catalog">
      <section class="catalog__main" id="tools" aria-labelledby="tools-heading">
        <h2 id="tools-heading" class="sr-only">Document tools</h2>

        <ul class="group-tabs" role="list" aria-label="Filter tools by task">
          {
            groupTabs.map(({ id, label, tone }) => (
              <li>
                <button
                  type="button"
                  class={`group-tab group-tab--${tone}`}
                  data-group-filter={id}
                  aria-pressed={id === 'All' ? 'true' : 'false'}
                >
                  <span>{label}</span>
                  <span class="group-tab__count">{groupCount(id)}</span>
                </button>
              </li>
            ))
          }
        </ul>

        <div class="tool-search">
          <label class="sr-only" for="tool-filter">Search tools</label>
          <div class="tool-search__box">
            <svg
              class="tool-search__icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-3.5-3.5" />
            </svg>
            <input
              id="tool-filter"
              class="input tool-search__input"
              type="search"
              placeholder="Search PDF tools, e.g. merge, split, or PNG"
              autocomplete="off"
              aria-describedby="tool-filter-count"
            />
            <kbd class="tool-search__kbd" aria-hidden="true">/</kbd>
          </div>
          <p id="tool-filter-count" class="tool-search__count" role="status" aria-live="polite">
            Showing {liveTools.length} of {liveTools.length} tools
          </p>
        </div>

        <ul class="tool-grid" role="list" id="tool-list">
          {
            liveTools.map((tool) => (
              <li
                data-tool-item
                data-group={tool.group}
                data-search={`${tool.name} ${tool.category} ${tool.group} ${tool.blurb}`.toLowerCase()}
              >
                <a
                  class="tool-card"
                  href={`/tools/${tool.id}`}
                  data-category={tool.category}
                  data-tool={tool.id}
                  data-accent={tool.accent}
                >
                  <span class="tool-card__top">
                    <ToolGlyph kind={tool.id as GlyphKind} tone={tool.accent} size="lg" />
                    <span class="tool-card__group">{tool.group}</span>
                  </span>
                  <span class="tool-card__title">{tool.name}</span>
                  <span class="tool-card__blurb">{tool.blurb}</span>
                  <span class="tool-card__action">
                    Open tool
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M5 12h14" /><path d="m13 6 6 6-6 6" />
                    </svg>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <div id="tool-filter-empty" class="note" hidden>
          <p>No tools match that filter.</p>
          <p>
            <button type="button" class="btn btn--secondary" id="tool-filter-reset">
              Show all tools
            </button>
          </p>
        </div>

        <p class="catalog__foot">
          Every tool is finished, tested and documented before the next one begins. Images, audio,
          text and everyday utilities follow next.
        </p>
      </section>

      <p class="rail-note">
        Files stay inside this browser tab. <a href="/privacy">Verify it in the Network tab</a>.
      </p>
    </div>

    <section class="stack" aria-labelledby="charter-heading">
      <h2 id="charter-heading" class="muted section-heading">How OpenDrawer works</h2>
      <ul class="value-cards" role="list">
        <li class="value-card value-card--inspect">
          <ToolGlyph kind="device" tone="inspect" size="lg" />
          <h3>Runs on your device</h3>
          <p>Your browser decodes and converts every file in local memory, even on slow mobile data.</p>
        </li>
        <li class="value-card value-card--convert">
          <ToolGlyph kind="shield" tone="convert" size="lg" />
          <h3>Verifiably zero uploads</h3>
          <p>No upload server exists, and the Content-Security-Policy blocks off-origin requests.</p>
        </li>
        <li class="value-card value-card--documents">
          <ToolGlyph kind="heart" tone="documents" size="lg" />
          <h3>Built for public goodwill</h3>
          <p>Free AGPL-3.0 software with no quotas, no watermarks, no accounts and no advertising.</p>
        </li>
      </ul>
    </section>

    <p class="colophon">
      <span>OpenDrawer</span>
      <span>AGPL-3.0 open source</span>
      <span>Static files, zero backend</span>
    </p>
  </div>

  <script>
    const input = document.getElementById('tool-filter') as HTMLInputElement | null;
    const count = document.getElementById('tool-filter-count');
    const empty = document.getElementById('tool-filter-empty');
    const reset = document.getElementById('tool-filter-reset');
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-tool-item]'));
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-group-filter]'));
    let activeGroup = 'All';

    function applyFilter() {
      if (!input || !count || !empty) return;
      const query = input.value.trim().toLowerCase();
      let visible = 0;

      for (const item of items) {
        const haystack = item.dataset.search ?? '';
        const itemGroup = item.dataset.group ?? '';
        const groupMatch = activeGroup === 'All' || itemGroup === activeGroup;
        const queryMatch = query === '' || haystack.includes(query);
        const match = groupMatch && queryMatch;
        item.hidden = !match;
        if (match) visible += 1;
      }

      const word = visible === 1 ? 'tool' : 'tools';
      count.textContent =
        query === '' && activeGroup === 'All'
          ? `Showing ${visible} of ${items.length} tools`
          : `Showing ${visible} matching ${word} of ${items.length}`;
      empty.hidden = visible > 0;
    }

    function setGroup(nextGroup: string) {
      activeGroup = nextGroup;
      for (const tab of tabs) {
        tab.setAttribute('aria-pressed', tab.dataset.groupFilter === nextGroup ? 'true' : 'false');
      }
      applyFilter();
    }

    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        setGroup(tab.dataset.groupFilter ?? 'All');
      });
    }

    input?.addEventListener('input', applyFilter);
    input?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && input.value !== '') {
        event.preventDefault();
        input.value = '';
        applyFilter();
      }
    });
    reset?.addEventListener('click', () => {
      if (!input) return;
      input.value = '';
      setGroup('All');
      input.focus();
    });
    window.addEventListener('keydown', (event) => {
      if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
      const target = event.target as HTMLElement | null;
      if (
        target &&
        (target.tagName === 'INPUT' ||
          target.tagName === 'TEXTAREA' ||
          target.tagName === 'SELECT' ||
          target.isContentEditable)
      ) {
        return;
      }
      if (!input) return;
      event.preventDefault();
      input.focus();
      input.select();
    });
  </script>
</Base>
