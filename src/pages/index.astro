---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import ToolGlyph from '../components/ToolGlyph.astro';
import { categories, liveTools } from '../lib/tools';

const grouped = categories.map((cat) => ({
  ...cat,
  items: liveTools.filter((tool) => tool.category === cat.id),
}));
---

<Base
  title="OpenDrawer — everyday file tools, kept on your device"
  description="Free, open-source file tools built for public goodwill across documents, images, media, text and everyday utilities. Offline after first load, zero accounts, zero tracking, zero uploads."
>
  <div class="stack-lg page-fill">
    <header class="page-head">
      <h1>Everyday file tools, kept on your device</h1>
      <p class="page-head__lead">
        Built for public goodwill as free open-source software under the AGPL-3.0. Every tool runs
        inside your browser and keeps working offline after the first load, with zero accounts, zero
        tracking and zero uploads.
      </p>
      <ul class="trust-strip" aria-label="Core guarantees">
        <li class="trust-chip--mint">0 uploads</li>
        <li class="trust-chip--sky">No account</li>
        <li class="trust-chip--amber">Offline ready</li>
        <li class="trust-chip--coral">AGPL-3.0</li>
      </ul>
    </header>

    <div class="catalog">
      <section class="catalog__main" id="tools" aria-label="Tool directory">
        <ul class="cat-tabs" role="list" aria-label="Tool categories">
          <li>
            <button type="button" class="cat-tab cat-tab--all" data-cat-filter="All" data-cat-summary="" aria-pressed="true">
              <span>All tools</span>
              <span class="cat-tab__count">{liveTools.length}</span>
            </button>
          </li>
          {
            grouped.map((cat) => (
              <li>
                <button
                  type="button"
                  class={`cat-tab cat-tab--${cat.tone}`}
                  data-cat-filter={cat.id}
                  data-cat-summary={cat.summary}
                  aria-pressed="false"
                >
                  <ToolGlyph kind={cat.tone} tone={cat.tone} size="sm" />
                  <span>{cat.id}</span>
                  {cat.items.length > 0 && <span class="cat-tab__count">{cat.items.length}</span>}
                </button>
              </li>
            ))
          }
        </ul>

        <div class="tool-search">
          <label class="sr-only" for="tool-filter">Search all tools</label>
          <div class="tool-search__box">
            <svg class="tool-search__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
            </svg>
            <input
              id="tool-filter"
              class="input tool-search__input"
              type="search"
              placeholder="Search tools, e.g. PDF, merge, PNG"
              autocomplete="off"
              aria-describedby="tool-filter-count"
            />
            <kbd class="tool-search__kbd" aria-hidden="true">/</kbd>
          </div>
          <p id="tool-filter-count" class="tool-search__count" role="status" aria-live="polite">
            Showing {liveTools.length} of {liveTools.length} tools
          </p>
        </div>

        <div class="cat-sections" id="cat-sections">
          {
            grouped
              .filter((cat) => cat.items.length > 0)
              .map((cat) => (
                <section class="cat-section" data-cat-section={cat.id} aria-labelledby={`cat-${cat.slug}`}>
                  <header class="cat-section__head">
                    <span class="cat-section__title">
                      <ToolGlyph kind={cat.tone} tone={cat.tone} size="md" />
                      <h2 id={`cat-${cat.slug}`}>{cat.id}</h2>
                      <span class="badge">{cat.items.length} {cat.items.length === 1 ? 'tool' : 'tools'}</span>
                    </span>
                    <p class="cat-section__summary">{cat.summary}</p>
                  </header>

                  <ul class="tool-grid" role="list">
                    {cat.items.map((tool) => <ToolCard tool={tool} fallbackIcon={cat.tone} />)}
                  </ul>
                </section>
              ))
          }
        </div>

        <div id="tool-filter-empty" class="empty-panel" hidden>
          <h2 id="tool-empty-title">No tools match that filter</h2>
          <p id="tool-empty-body">Try a different keyword or view every tool currently live.</p>
          <button type="button" class="btn btn--secondary" id="tool-filter-reset">
            Show all tools
          </button>
        </div>

        <p class="catalog__foot">
          Every tool is finished, tested and documented before the next one begins.
        </p>
      </section>

      <p class="rail-note">
        Files stay inside this browser tab. <a href="/privacy">Verify it in the Network tab</a>.
      </p>
    </div>

    <section class="stack" aria-labelledby="charter-heading">
      <h2 id="charter-heading" class="muted section-heading">How OpenDrawer works</h2>
      <ul class="value-cards" role="list">
        <li class="value-card value-card--inspect">
          <ToolGlyph kind="device" tone="inspect" size="lg" />
          <h3>Runs on your device</h3>
          <p>Your browser decodes and converts every file in local memory, even on slow mobile data.</p>
        </li>
        <li class="value-card value-card--convert">
          <ToolGlyph kind="shield" tone="convert" size="lg" />
          <h3>Verifiably zero uploads</h3>
          <p>No upload server exists, and the Content-Security-Policy blocks off-origin requests.</p>
        </li>
        <li class="value-card value-card--documents">
          <ToolGlyph kind="heart" tone="documents" size="lg" />
          <h3>Built for public goodwill</h3>
          <p>Free AGPL-3.0 software with no quotas, no watermarks, no accounts and no advertising.</p>
        </li>
      </ul>
    </section>

    <p class="colophon">
      <span>OpenDrawer</span>
      <span>AGPL-3.0 open source</span>
      <span>Static files, zero backend</span>
    </p>
  </div>

  <script>
    const input = document.getElementById('tool-filter') as HTMLInputElement | null;
    const count = document.getElementById('tool-filter-count');
    const empty = document.getElementById('tool-filter-empty');
    const emptyTitle = document.getElementById('tool-empty-title');
    const emptyBody = document.getElementById('tool-empty-body');
    const reset = document.getElementById('tool-filter-reset');
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-cat-section]'));
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-tool-item]'));
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-cat-filter]'));
    let activeCategory = 'All';

    function applyFilter() {
      if (!input || !count || !empty) return;
      const query = input.value.trim().toLowerCase();
      let visible = 0;

      for (const item of items) {
        const catMatch = activeCategory === 'All' || item.dataset.category === activeCategory;
        const queryMatch = query === '' || (item.dataset.search ?? '').includes(query);
        const match = catMatch && queryMatch;
        item.hidden = !match;
        if (match) visible += 1;
      }

      for (const section of sections) {
        const sectionItems = Array.from(section.querySelectorAll<HTMLElement>('[data-tool-item]'));
        section.hidden = sectionItems.every((item) => item.hidden);
      }

      const word = visible === 1 ? 'tool' : 'tools';
      count.textContent =
        query === '' && activeCategory === 'All'
          ? `Showing ${visible} of ${items.length} tools`
          : `Showing ${visible} matching ${word} of ${items.length}`;

      empty.hidden = visible > 0;
      if (visible === 0 && emptyTitle && emptyBody) {
        const activeTab = tabs.find((t) => t.dataset.catFilter === activeCategory);
        const summary = activeTab?.dataset.catSummary ?? '';
        if (query === '' && activeCategory !== 'All' && summary) {
          emptyTitle.textContent = `${activeCategory} tools are queued next`;
          emptyBody.textContent = summary;
        } else {
          emptyTitle.textContent = 'No tools match that filter';
          emptyBody.textContent = 'Try another keyword or clear the category filter.';
        }
      }
    }

    function setCategory(next: string) {
      activeCategory = next;
      for (const tab of tabs) {
        tab.setAttribute('aria-pressed', tab.dataset.catFilter === next ? 'true' : 'false');
      }
      applyFilter();
    }

    for (const tab of tabs) {
      tab.addEventListener('click', () => setCategory(tab.dataset.catFilter ?? 'All'));
    }
    input?.addEventListener('input', applyFilter);
    input?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && input.value !== '') {
        event.preventDefault();
        input.value = '';
        applyFilter();
      }
    });
    reset?.addEventListener('click', () => {
      if (input) input.value = '';
      setCategory('All');
      input?.focus();
    });
    window.addEventListener('keydown', (event) => {
      if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
      const tag = (event.target as HTMLElement | null)?.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
      if (!input) return;
      event.preventDefault();
      input.focus();
      input.select();
    });
  </script>
</Base>
