---
import Base from '../layouts/Base.astro';
import ToolGlyph, { type GlyphKind, type GlyphTone } from '../components/ToolGlyph.astro';
import { liveTools, tools, type ToolCategory } from '../lib/tools';

const categories: Array<{ name: ToolCategory; kind: GlyphKind; tone: GlyphTone }> = [
  { name: 'Documents', kind: 'documents', tone: 'documents' },
  { name: 'Images', kind: 'images', tone: 'images' },
  { name: 'Audio & video', kind: 'audio', tone: 'audio' },
  { name: 'Text & data', kind: 'textdata', tone: 'textdata' },
  { name: 'Everyday', kind: 'everyday', tone: 'everyday' },
];

function countIn(name: ToolCategory) {
  return tools.filter((tool) => tool.category === name && tool.status === 'live').length;
}
---

<Base
  title="OpenDrawer — everyday file tools, kept on your device"
  description="Free, open-source file tools built for public goodwill. Inspect a PDF or render pages to images inside your browser: offline after first load, zero accounts, zero tracking, zero uploads."
>
  <div class="stack-lg page-fill">
    <header class="page-head">
      <h1>Everyday file tools, kept on your device</h1>
      <p class="page-head__lead">
        Built for public goodwill as free open-source software under the AGPL-3.0. Every tool runs
        inside your browser and keeps working offline after the first load, with zero accounts, zero
        tracking and zero uploads.
      </p>
      <ul class="trust-strip" aria-label="Core guarantees">
        <li class="trust-chip--mint">0 uploads</li>
        <li class="trust-chip--sky">No account</li>
        <li class="trust-chip--amber">Offline ready</li>
        <li class="trust-chip--coral">AGPL-3.0</li>
      </ul>
    </header>

    <div class="catalog">
      <aside class="catalog__rail" aria-labelledby="categories-heading">
        <h2 id="categories-heading">Categories</h2>
        <ul class="cat-list" role="list">
          {
            categories.map(({ name, kind, tone }) => {
              const count = countIn(name);
              const active = count > 0;
              return (
                <li class={`cat${active ? ' cat--active' : ''}`}>
                  <span class="cat__label">
                    <ToolGlyph kind={kind} tone={tone} size="sm" />
                    <span>{name}</span>
                  </span>
                  <span class="cat__count">{active ? count : 'Planned'}</span>
                </li>
              );
            })
          }
        </ul>
      </aside>

      <section class="catalog__main" id="tools" aria-labelledby="tools-heading">
        <div class="catalog__head">
          <h2 id="tools-heading">Documents</h2>
          <span class="badge">{liveTools.length} live tools</span>
        </div>

        <div class="tool-search">
          <label class="field__label" for="tool-filter">Filter tools</label>
          <div class="tool-search__bar">
            <div class="tool-search__box">
              <input id="tool-filter" class="input tool-search__input" type="search" placeholder="Search tools, e.g. metadata or PNG" autocomplete="off" aria-describedby="tool-filter-count" />
              <kbd class="tool-search__kbd" aria-hidden="true">/</kbd>
            </div>
          </div>
          <p id="tool-filter-count" class="tool-search__count" role="status" aria-live="polite">
            Showing {liveTools.length} of {liveTools.length} tools
          </p>
        </div>

        <ul class="tool-list" role="list" id="tool-list">
          {
            liveTools.map((tool) => (
              <li data-tool-item data-search={`${tool.name} ${tool.category} ${tool.group} ${tool.blurb}`.toLowerCase()}>
                <a class="tool-row" href={`/tools/${tool.id}`} data-category={tool.category} data-tool={tool.id} data-accent={tool.accent}>
                  <ToolGlyph kind={tool.id as GlyphKind} tone={tool.accent} size="lg" />
                  <span class="tool-row__text">
                    <span class="tool-row__head">
                      <span class="tool-row__title">{tool.name}</span>
                      <span class="tool-row__group">{tool.group}</span>
                    </span>
                    <span class="tool-row__blurb">{tool.blurb}</span>
                  </span>
                  <span class="tool-row__action">
                    Open
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M5 12h14" /><path d="m13 6 6 6-6 6" />
                    </svg>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <div id="tool-filter-empty" class="note" hidden>
          <p>No tools match that filter.</p>
          <p>
            <button type="button" class="btn btn--secondary" id="tool-filter-reset">
              Show all tools
            </button>
          </p>
        </div>

        <p class="catalog__foot">
          Every tool is finished, tested and documented before the next one begins.
        </p>
      </section>

      <p class="rail-note">
        Files stay inside this browser tab. <a href="/privacy">Verify it in the Network tab</a>.
      </p>
    </div>

    <section class="stack" aria-labelledby="charter-heading">
      <h2 id="charter-heading" class="muted section-heading">How OpenDrawer works</h2>
      <ol class="steps">
        <li>
          <div class="step__head"><ToolGlyph kind="device" tone="inspect" size="md" /><span class="step__num step__num--inspect">01</span></div>
          <h3>Runs on your device</h3>
          <p>Your browser decodes and converts every file in local memory, even on slow mobile data.</p>
        </li>
        <li>
          <div class="step__head"><ToolGlyph kind="shield" tone="convert" size="md" /><span class="step__num step__num--convert">02</span></div>
          <h3>Verifiably zero uploads</h3>
          <p>No upload server exists, and the Content-Security-Policy blocks off-origin requests.</p>
        </li>
        <li>
          <div class="step__head"><ToolGlyph kind="heart" tone="documents" size="md" /><span class="step__num step__num--documents">03</span></div>
          <h3>Built for public goodwill</h3>
          <p>Free AGPL-3.0 software with no quotas, no watermarks, no accounts and no advertising.</p>
        </li>
      </ol>
    </section>

    <p class="colophon">
      <span>OpenDrawer</span>
      <span>AGPL-3.0 open source</span>
      <span>Static files, zero backend</span>
    </p>
  </div>

  <script>
    const input = document.getElementById('tool-filter') as HTMLInputElement | null;
    const count = document.getElementById('tool-filter-count');
    const empty = document.getElementById('tool-filter-empty');
    const reset = document.getElementById('tool-filter-reset');
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-tool-item]'));

    function applyFilter() {
      if (!input || !count || !empty) return;
      const query = input.value.trim().toLowerCase();
      let visible = 0;

      for (const item of items) {
        const haystack = item.dataset.search ?? '';
        const match = query === '' || haystack.includes(query);
        item.hidden = !match;
        if (match) visible += 1;
      }

      const word = visible === 1 ? 'tool' : 'tools';
      count.textContent =
        query === ''
          ? `Showing ${visible} of ${items.length} tools`
          : `Showing ${visible} matching ${word} of ${items.length}`;
      empty.hidden = visible > 0;
    }

    input?.addEventListener('input', applyFilter);
    input?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && input.value !== '') {
        event.preventDefault();
        input.value = '';
        applyFilter();
      }
    });
    reset?.addEventListener('click', () => {
      if (!input) return;
      input.value = '';
      applyFilter();
      input.focus();
    });
    window.addEventListener('keydown', (event) => {
      if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
      const target = event.target as HTMLElement | null;
      if (
        target &&
        (target.tagName === 'INPUT' ||
          target.tagName === 'TEXTAREA' ||
          target.tagName === 'SELECT' ||
          target.isContentEditable)
      ) {
        return;
      }
      if (!input) return;
      event.preventDefault();
      input.focus();
      input.select();
    });
  </script>
</Base>
